# .env.example — copy this to .env and fill in the values
# Run:  bash scripts/generate_env.sh  to auto-generate

# AES/Fernet encryption key (generate with generate_env.sh)
VOICE_AI_ENCRYPTION_KEY=your_fernet_key_here

# Ollama local LLM settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
